# PAPERCHASERS — env example
# Copy to .env / set in hosting (Vercel, Netlify, etc.) — DO NOT commit real keys

# Yandex Maps JS API v3 — https://developer.tech.yandex.ru
YANDEX_MAPS_API_KEY=

# CDEK API 2.0 — https://lk.cdek.ru / https://api.cdek.ru
# CDEK account and secure_password are SECRET — use only on server (api/cdek/pvz)
CDEK_ACCOUNT=
CDEK_SECURE=

# Optional
CDEK_API_URL=https://api.cdek.ru/v2
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY is alternative name for frontend (public)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
